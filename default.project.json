{
  "name": "RbxFastCast2Place",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "FastCast2Serial": {
        "$path": "vendor/FastCast2Serial/src"
      },
      "FastCast2Parallel": {
        "$path": "vendor/FastCast2Parallel/src"
      },
      "Projectiles": {
        "$path": "projectiles"
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterPack": {
      "BasicFire": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Fire a FastCast2 projectile toward the mouse"
        },
        "$path": "src/tools/BasicFire"
      },
      "Benchmark": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Run FastCast2 benchmark scenarios"
        },
        "$path": "src/tools/Benchmark"
      },
      "ConfigUI": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Edit FastCast2 settings"
        },
        "$path": "src/tools/ConfigUI"
      },
      "UnitTest": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Run FastCast2 test scenarios"
        },
        "$path": "src/tools/UnitTest"
      }
    }
  }
}
