{
  "name": "RbxFastCast2Place",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "FastCast2Serial": {
        "$path": "vendor/FastCast2Serial/src"
      },
      "FastCast2Parallel": {
        "$path": "vendor/FastCast2Parallel/src"
      },
      "Projectiles": {
        "$path": "projectiles"
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPack": {
      "BasicFire": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Fire a FastCast2 projectile toward the mouse"
        },
        "$path": "src/tools/BasicFire"
      },
      "ConfigUI": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Edit FastCast2 settings"
        },
        "$path": "src/tools/ConfigUI"
      },
      "Benchmark": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Run Serial and Parallel FastCast2 benchmarks"
        },
        "$path": "src/tools/Benchmark"
      },
      "PerfBench": {
        "$className": "Tool",
        "$properties": {
          "RequiresHandle": false,
          "CanBeDropped": false,
          "ToolTip": "Run the server-side stress benchmark using FastCast2 module Config"
        },
        "$path": "src/tools/PerfBench"
      }
    }
  }
}
